# GitHub SSOT
github: {
  label: "GitHub · SSOT\n唯一真实数据源"
  shape: cylinder
  style.fill: "#1a1a2e"
  style.font-color: white
  style.stroke: "#4a4a8a"
}

# 四层垂直关系
brand -> system: "定义规则\n系统叙事" {
  style.stroke: "#6060cc"
  style.bold: true
}
system -> modules: "调度能力\n承载决策" {
  style.stroke: "#6020cc"
  style.bold: true
}
modules -> engines: "提供能力与工具\nSOP · 规程 · 策略" {
  style.stroke: "#4a8a10"
  style.bold: true
}

# 飞轮闭环：数据回流
engines -> system: "数据回流\n优化结构" {
  style.stroke: "#e94560"
  style.bold: true
  style.stroke-dash: 3
}
system -> engines: "结构反哺\n提升效率" {
  style.stroke: "#4a8a10"
  style.stroke-dash: 3
}

# GitHub 连接
modules.core -> github: "状态回写" {
  style.stroke: "#4a4a8a"
}
github -> modules.core: "每次接入读取基线" {
  style.stroke: "#4a4a8a"
  style.stroke-dash: 3
}
