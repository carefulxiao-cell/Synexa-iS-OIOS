    style.font-color: "#a0a0ff"
    style.stroke: "#3a3a8a"
    style.border-radius: 8
    style.font-size: 11
  }
  sco: {
    label: "iS-SCO\n枢机经纬\n【策略室】\n战略推演"
    shape: rectangle
    style.fill: "#0f3460"
    style.font-color: white
    style.stroke: "#e94560"
    style.border-radius: 8
    style.font-size: 11
  }
  matrix: {
    label: "iS-Matrix\n智核矩阵\n【研究培训室】\n结构化生产"
    shape: rectangle
    style.fill: "#533483"
    style.font-color: white
    style.stroke: "#7a4fc0"
    style.border-radius: 8
    style.font-size: 11
  }
  pcs: {
    label: "iS-PCS\n项目执行系统\n【项目组】\n推进器"
    shape: rectangle
    style.fill: "#1e3a5f"
    style.font-color: white
