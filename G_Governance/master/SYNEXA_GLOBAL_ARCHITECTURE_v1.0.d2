direction: down

title: {
  label: "Synexa iS 全局生态架构 v1.6"
  near: top-center
  style.font-size: 20
  style.bold: true
}

# ============================================================
# Layer 4：全局治理层（原则 + 知讯 + 能力原子供给基座）
# ============================================================

L4: "Layer 4 · 全局治理层" {
  style.border-radius: 8
  style.stroke: "#F5A623"
  style.stroke-width: 5
  style.fill: transparent

  # A · 原则层
  ATOMS_A: "A · 原则层（AI 遵什么）" {
    style.stroke: "#F5A623"
    style.stroke-width: 2
    style.stroke-dash: 4
    style.fill: "#FFFDF0"

    CORE: "A1 全局原则\nCORE_PRINCIPLES.md" {
      style.stroke: "#F5A623"
      style.stroke-width: 2
      style.fill: transparent
      style.font-size: 12
    }
    RACI: "A2 角色责任映射\nRACI.md" {
      style.stroke: "#F5A623"
      style.stroke-width: 2
      style.fill: transparent
      style.font-size: 12
    }
    DF_REF: "A3 人机沟通原则\nDIALOGUE_FRAMEWORK.md" {
      style.stroke: "#F5A623"
      style.stroke-width: 2
      style.fill: transparent
      style.font-size: 12
    }
    TP_REF: "A4 专项工具原则\nTOOL_PRINCIPLES.md" {
      style.stroke: "#F5A623"
      style.stroke-width: 2
      style.fill: transparent
      style.font-size: 12
    }
    DR: "A5 领域映射·清洗\nDOMAIN_REGISTRY.md" {
      style.stroke: "#F5A623"
      style.stroke-width: 2
      style.fill: transparent
      style.font-size: 12
    }
  }

  # C · 能力层（Skill）
  SKILLS: "C · 能力层（可触发词激活的 Skill 模块）" {
    style.stroke: "#F5A623"
    style.stroke-width: 2
    style.stroke-dash: 4
    style.fill: "#FFFBE6"

    SK1: "C1 触发词激活\nTRIGGER_CHEATSHEET_SKILL" {
      style.stroke: "#F5A623"
      style.stroke-width: 2
      style.fill: transparent
      style.font-size: 12
    }
    SK2: "C2 Skill·指令体系\nPROMPT_ENGINEERING_SKILL" {
      style.stroke: "#F5A623"
      style.stroke-width: 2
      style.fill: transparent
      style.font-size: 12
    }
    SK3: "C5 任务汇总·报告生成\nTASK_SUMMARY_SKILL" {
      style.stroke: "#F5A623"
      style.stroke-width: 2
      style.fill: transparent
      style.font-size: 12
    }
  }

  # 其他治理文件
  VER: "B7 版本控制\nVERSION_REGISTRY.md" {
    style.stroke: "#F5A623"
    style.stroke-width: 2
    style.fill: transparent
  }
  ITER: "C4 反向审查·迭代\nITER_PROTOCOL.md" {
    style.stroke: "#F5A623"
    style.stroke-width: 2
    style.fill: transparent
  }
  REPO: "REPO_INDEX.md\n仓库文件全局索引" {
    style.stroke: "#F5A623"
    style.stroke-width: 2
    style.fill: transparent
  }
  KR: "KNOWLEDGE_REGISTRY.md\n知识资产注册表（横向贯穿）" {
    style.stroke: "#F5A623"
    style.stroke-width: 2
    style.stroke-dash: 4
    style.fill: transparent
  }

  triggers_L4: "触发词\n`触发词` / `触发词速查`\n`输出任务快照` / `更新任务台账`\n`优化工作空间规范 [代号]`\n`全局检查同步` / `迭代 [文件名]`" {
    style.stroke: "#F5A623"
    style.stroke-width: 1
    style.stroke-dash: 3
    style.fill: transparent
    style.font-size: 12
  }
}

