# ============================================================
# Layer 2：同组协作层
# ============================================================

L2: "Layer 2 · 同组协作层（以 NexFlow 为例）" {
  style.border-radius: 8
  style.stroke: "#00C853"
  style.stroke-width: 5
  style.fill: transparent

  HUB: "中枢框\n指令生产 · 目标确认 · 阶段裁决" {
    style.stroke: "#00C853"
    style.stroke-width: 2
    style.fill: transparent
  }
  EXE: "执行框（执行-）\n系统/网站/代码类工程生产" {
    style.stroke: "#00C853"
    style.stroke-width: 2
    style.fill: transparent
  }
  BZ: "编撰框（编撰-）\n文件/知识/治理文档类生产" {
    style.stroke: "#00C853"
    style.stroke-width: 2
    style.fill: transparent
  }
  REV: "审查框（审查-）\n里程碑独立审查 · 全程上下文连续" {
    style.stroke: "#00C853"
    style.stroke-width: 2
    style.fill: transparent
  }
  TBF: "TBF 任务目标基线\n（四框共享，中枢框维护）" {
    style.stroke: "#00C853"
    style.stroke-width: 1
    style.stroke-dash: 3
    style.fill: transparent
  }
  TG: "TRIGGER_GLOSSARY.md\n项目级触发词汇总表" {
    style.stroke: "#00C853"
    style.stroke-width: 2
    style.fill: transparent
  }

  HUB -> EXE: "工程指令包 + TBF"
  HUB -> BZ: "文档指令包 + TBF"
  EXE -> HUB: "自审通过后提交"
  BZ -> HUB: "编撰完成后提交"
  HUB -> REV: "关键里程碑触发"
  REV -> HUB: "审查结论"

  triggers_L2: "触发词\n`全面审查 [系统]`\n`生成启动语`" {
    style.stroke: "#00C853"
    style.stroke-width: 1
    style.stroke-dash: 3
    style.fill: transparent
    style.font-size: 12
  }
}

