direction: down

title: {
  label: "Synexa 体系架构图 v1.1\n四层架构 · 增长飞轮"
  near: top-center
  shape: text
  style.font-size: 18
  style.bold: true
}

# ① Brand Layer
brand: {
  label: "① Brand Layer｜品牌层\nSynexa｜超智\n顶层商业标识 · 系统叙事入口\n以协同为核心、驱动系统性效能的基础平台"
  shape: rectangle
  style.fill: "#0a0a1a"
  style.font-color: "#e8e8ff"
  style.stroke: "#6060cc"
  style.border-radius: 12
  style.font-size: 13
}

# ② System Layer
system: {
  label: "② System Layer｜系统层\nSynexa iS｜智能系统基座（Intelligent System）\n协同调度 · 决策支撑 · 能力组织 · 数据与规则运行\n⚠️ 防塌规则：不做业务，不直接产生收入，只提供能力与调度"
  shape: rectangle
  style.fill: "#0f1a3a"
  style.font-color: "#a0c0ff"
  style.stroke: "#2060cc"
  style.border-radius: 12
  style.font-size: 12
}

# ③ Module Layer
modules: {
  label: "③ Module Layer｜模块层\niS Modules｜智核模块体系（组织操作系统级别）"
  shape: rectangle
  style.fill: "#1a0f3a"
  style.font-color: "#c0a0ff"
  style.stroke: "#6020cc"
  style.border-radius: 12
  style.font-size: 13

  core: {
    label: "iS-Core\n智核中枢\n【董事会】\n治理与裁决"
    shape: rectangle
